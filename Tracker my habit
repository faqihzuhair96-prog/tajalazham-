<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pelacak Kebiasaan & Sistem Poin Diri</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom Scrollbars and Micro-interactions */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
    .glass-card {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .custom-checkbox:checked + div {
      background-color: #22c55e;
      border-color: #22c55e;
    }
  </style>
</head>
<body class="h-full font-sans antialiased bg-slate-950 text-slate-100 flex flex-col selection:bg-brand-500 selection:text-white">

  <header class="sticky top-0 z-30 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center shadow-lg shadow-brand-500/20">
          <i class="fa-solid fa-trophy text-white text-lg"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight tracking-tight text-white">HabitPoints <span class="text-xs px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-400 font-medium">Pro</span></h1>
          <p class="text-xs text-slate-400">Pelacak Kebiasaan & Produktivitas Kerja</p>
        </div>
      </div>

      <!-- Quick Stats Header Bar -->
      <div class="flex items-center gap-3 sm:gap-6 bg-slate-800/80 px-4 py-2 rounded-2xl border border-slate-700/50 text-xs sm:text-sm">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-coins text-amber-400"></i>
          <div>
            <span class="text-slate-400 block text-[10px] leading-none">TOTAL POIN</span>
            <span id="userPoints" class="font-bold text-amber-400 text-sm sm:text-base">0</span>
          </div>
        </div>
        <div class="h-6 w-px bg-slate-700"></div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-fire text-orange-500"></i>
          <div>
            <span class="text-slate-400 block text-[10px] leading-none">STREAK</span>
            <span id="userStreak" class="font-bold text-orange-400 text-sm sm:text-base">0 Hari</span>
          </div>
        </div>
        <div class="h-6 w-px bg-slate-700"></div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-emerald-400"></i>
          <div>
            <span class="text-slate-400 block text-[10px] leading-none">LEVEL</span>
            <span id="userLevel" class="font-bold text-emerald-400 text-sm sm:text-base">Level 1</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    
    <!-- Tab Controls -->
    <nav class="flex items-center p-1.5 gap-1.5 bg-slate-900 border border-slate-800 rounded-2xl overflow-x-auto">
      <button onclick="switchTab('dashboard')" id="tabBtn-dashboard" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition-all bg-brand-600 text-white shadow-md">
        <i class="fa-solid fa-chart-pie"></i> Kebiasaan & Ringkasan
      </button>
      <button onclick="switchTab('productivity')" id="tabBtn-productivity" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition-all text-slate-400 hover:text-slate-200 hover:bg-slate-800/50">
        <i class="fa-solid fa-calendar-week"></i> Jadwal Kerja (Selasa - Minggu)
      </button>
      <button onclick="switchTab('rewards')" id="tabBtn-rewards" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition-all text-slate-400 hover:text-slate-200 hover:bg-slate-800/50">
        <i class="fa-solid fa-gift"></i> Toko Hadiah Diri
      </button>
      <button onclick="switchTab('history')" id="tabBtn-history" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition-all text-slate-400 hover:text-slate-200 hover:bg-slate-800/50">
        <i class="fa-solid fa-clock-rotate-left"></i> Riwayat Poin
      </button>
    </nav>

    <!-- TAB 1: DASHBOARD & HABITS -->
    <section id="section-dashboard" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="glass-card p-5 rounded-2xl flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-brand-400 tracking-wider uppercase">Progres Level</span>
            <h3 class="text-xl font-bold mt-1 text-slate-100" id="levelName">Pemula Disiplin</h3>
            <p class="text-xs text-slate-400 mt-1">Selesaikan kebiasaan & jadwal harian untuk naik level!</p>
          </div>
          <div class="mt-4">
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>XP Ke Level Berikutnya</span>
              <span id="xpProgressText">0 / 100 Poin</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden border border-slate-700/50">
              <div id="xpBar" class="bg-gradient-to-r from-brand-500 to-emerald-400 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <div class="glass-card p-5 rounded-2xl flex flex-col justify-between">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-xs font-semibold text-blue-400 tracking-wider uppercase">Target Kebiasaan Hari Ini</span>
              <h3 class="text-2xl font-extrabold mt-1 text-slate-100" id="todayHabitCount">0 / 0</h3>
            </div>
            <div class="p-3 bg-blue-500/10 text-blue-400 rounded-xl">
              <i class="fa-solid fa-circle-check text-xl"></i>
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-3">Konsistensi harian kunci membuka reward impianmu.</p>
        </div>

        <div class="glass-card p-5 rounded-2xl flex flex-col justify-between">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-xs font-semibold text-amber-400 tracking-wider uppercase">Tukar Poin</span>
              <h3 class="text-2xl font-extrabold mt-1 text-amber-400" id="dashTotalPoints">0 Poin</h3>
            </div>
            <div class="p-3 bg-amber-500/10 text-amber-400 rounded-xl">
              <i class="fa-solid fa-coins text-xl"></i>
            </div>
          </div>
          <button onclick="switchTab('rewards')" class="mt-3 w-full py-2 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-store"></i> Buka Toko Hadiah
          </button>
        </div>
      </div>

      <!-- Habits Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900 p-4 rounded-2xl border border-slate-800">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-list-check text-brand-400"></i> Daftar Kebiasaan Harian
          </h2>
          <p class="text-xs text-slate-400">Tandai kebiasaan positif untuk klaim poin atau atasi rutinitas buruk.</p>
        </div>
        <button onclick="openHabitModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-brand-600/20 flex items-center justify-center gap-2">
          <i class="fa-solid fa-plus"></i> Tambah Kebiasaan
        </button>
      </div>

      <!-- Habits List Grid -->
      <div id="habitsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- JS Dynamic Content -->
      </div>
    </section>

    <!-- TAB 2: PRODUCTIVITY & WORK SCHEDULE -->
    <section id="section-productivity" class="space-y-6 hidden">
      <!-- Section Intro Banner -->
      <div class="glass-card p-6 rounded-3xl border border-slate-800 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-400 text-xs font-bold uppercase tracking-wider">Jadwal Kerja Produktif</span>
              <span class="text-xs text-slate-400">• Selasa - Minggu</span>
            </div>
            <h2 class="text-2xl font-extrabold text-white">Kelola Waktu & Agenda Kerja Harian</h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl">
              Atur slot waktu kerja dari hari Selasa hingga Minggu. Selesaikan agenda produktif untuk mendapatkan bonus poin performa harian!
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button onclick="openScheduleManageModal()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl text-xs font-bold transition-all flex items-center gap-2">
              <i class="fa-solid fa-sliders text-brand-400"></i> Kelola & Edit Jadwal
            </button>
            <button onclick="openAddScheduleItemModal()" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-brand-600/20 flex items-center gap-2">
              <i class="fa-solid fa-plus"></i> Tambah Tugas Harian
            </button>
          </div>
        </div>
      </div>

      <!-- Day Selector Bar (Selasa s/d Minggu) -->
      <div class="flex items-center gap-2 p-2 bg-slate-900 border border-slate-800 rounded-2xl overflow-x-auto scrollbar-none">
        <button onclick="selectDay('Selasa')" id="dayTab-Selasa" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-brand-600 text-white shadow-md">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 1</span>
          Selasa
        </button>
        <button onclick="selectDay('Rabu')" id="dayTab-Rabu" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-slate-800 text-slate-400 hover:text-slate-200">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 2</span>
          Rabu
        </button>
        <button onclick="selectDay('Kamis')" id="dayTab-Kamis" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-slate-800 text-slate-400 hover:text-slate-200">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 3</span>
          Kamis
        </button>
        <button onclick="selectDay('Jumat')" id="dayTab-Jumat" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-slate-800 text-slate-400 hover:text-slate-200">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 4</span>
          Jumat
        </button>
        <button onclick="selectDay('Sabtu')" id="dayTab-Sabtu" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-slate-800 text-slate-400 hover:text-slate-200">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 5</span>
          Sabtu
        </button>
        <button onclick="selectDay('Minggu')" id="dayTab-Minggu" class="day-tab flex-1 min-w-[100px] py-3 px-4 rounded-xl text-center text-xs font-bold transition-all bg-slate-800 text-slate-400 hover:text-slate-200">
          <span class="block text-[10px] uppercase opacity-75 font-normal">HARI 6</span>
          Minggu
        </button>
      </div>

      <!-- Schedule Progress & Control Header -->
      <div class="glass-card p-4 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-brand-400 font-bold">
            <i class="fa-solid fa-calendar-day"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              Jadwal Kerja: <span id="currentDayTitle" class="text-brand-400">Selasa</span>
            </h3>
            <p class="text-xs text-slate-400" id="scheduleCompletionSubtitle">0 dari 0 tugas selesai</p>
          </div>
        </div>

        <div class="w-full sm:w-64 space-y-1">
          <div class="flex justify-between text-xs text-slate-400">
            <span>Penyelesaian Hari Ini</span>
            <span id="dayProgressPercent" class="font-bold text-white">0%</span>
          </div>
          <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-700/50">
            <div id="dayProgressBar" class="bg-brand-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- Daily Timeline Tasks List -->
      <div id="scheduleTimeline" class="space-y-3">
        <!-- Dynamic Schedule items inserted via JS -->
      </div>
    </section>

    <!-- TAB 3: SELF-REWARDS SHOP -->
    <section id="section-rewards" class="space-y-6 hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900 p-4 rounded-2xl border border-slate-800">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-gift text-amber-400"></i> Toko Self-Reward (Apresiasi Diri)
          </h2>
          <p class="text-xs text-slate-400">Tukarkan poin kerja kerasmu dengan hadiah hiburan yang menyenangkan!</p>
        </div>
        <button onclick="openRewardModal()" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-amber-600/20 flex items-center justify-center gap-2">
          <i class="fa-solid fa-plus"></i> Tambah Hadiah Baru
        </button>
      </div>

      <!-- Rewards Grid -->
      <div id="rewardsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Dynamic Rewards inserted via JS -->
      </div>
    </section>

    <!-- TAB 4: HISTORY -->
    <section id="section-history" class="space-y-6 hidden">
      <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-receipt text-blue-400"></i> Log Riwayat Poin
          </h2>
          <p class="text-xs text-slate-400">Catatan masuk & keluar poin dari kebiasaan, jadwal kerja, dan klaim reward.</p>
        </div>
        <button onclick="clearHistoryLog()" class="px-3 py-1.5 bg-slate-800 hover:bg-rose-900/40 text-slate-400 hover:text-rose-300 border border-slate-700 rounded-xl text-xs font-medium transition-all">
          <i class="fa-solid fa-trash"></i> Bersihkan Log
        </button>
      </div>

      <div class="glass-card rounded-2xl overflow-hidden border border-slate-800">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-900/90 text-slate-400 uppercase font-semibold border-b border-slate-800">
              <tr>
                <th class="px-4 py-3">Waktu</th>
                <th class="px-4 py-3">Aktivitas / Agenda</th>
                <th class="px-4 py-3">Kategori</th>
                <th class="px-4 py-3 text-right">Poin</th>
              </tr>
            </thead>
            <tbody id="historyTableBody" class="divide-y divide-slate-800/60">
              <!-- Dynamic Rows inserted via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- MODAL 1: ADD/EDIT HABIT -->
  <div id="modalHabit" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="glass-card max-w-md w-full rounded-3xl p-6 border border-slate-700 shadow-2xl relative animate-in fade-in zoom-in duration-200">
      <button onclick="closeHabitModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <i class="fa-solid fa-plus-circle text-brand-400"></i> Tambah Kebiasaan Baru
      </h3>
      <form id="formHabit" onsubmit="saveHabit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Kebiasaan</label>
          <input type="text" id="habitTitle" required placeholder="Contoh: Minum 2L Air / Olahraga 20m" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Poin Dihasilkan</label>
            <input type="number" id="habitPoints" min="1" max="100" value="15" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Kategori</label>
            <select id="habitCategory" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500">
              <option value="Kesehatan">Kesehatan</option>
              <option value="Fokus">Fokus & Belajar</option>
              <option value="Mindset">Mindset & Jiwa</option>
              <option value="Rutinitas">Rutinitas Harian</option>
            </select>
          </div>
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeHabitModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold">Batal</button>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-brand-600/20">Simpan Kebiasaan</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: ADD SINGLE SCHEDULE ITEM -->
  <div id="modalScheduleItem" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="glass-card max-w-md w-full rounded-3xl p-6 border border-slate-700 shadow-2xl relative">
      <button onclick="closeScheduleItemModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <i class="fa-solid fa-clock text-brand-400"></i> <span id="modalScheduleTitle">Tambah Tugas Harian</span>
      </h3>
      <form id="formScheduleItem" onsubmit="saveScheduleItem(event)" class="space-y-4">
        <input type="hidden" id="schedItemId" />
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Pilih Hari</label>
          <select id="schedDay" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500">
            <option value="Selasa">Selasa</option>
            <option value="Rabu">Rabu</option>
            <option value="Kamis">Kamis</option>
            <option value="Jumat">Jumat</option>
            <option value="Sabtu">Sabtu</option>
            <option value="Minggu">Minggu</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Jam Mulai</label>
            <input type="time" id="schedStartTime" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Jam Selesai</label>
            <input type="time" id="schedEndTime" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Agenda / Kerjaan</label>
          <input type="text" id="schedTitle" required placeholder="Contoh: Focus Work / Meeting Client / Coding" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Bonus Poin Selesai</label>
            <input type="number" id="schedPoints" min="1" max="100" value="10" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Kategori Agenda</label>
            <select id="schedCategory" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-500">
              <option value="Kerja Utuh">Kerja Utuh (Deep Work)</option>
